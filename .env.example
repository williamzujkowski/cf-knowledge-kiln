# cf-knowledge-kiln — example environment variables
# Copy to .env (gitignored) and fill in. In Cloud Foundry, set these via
# `cf set-env` or via service bindings (VCAP_SERVICES).

# ─── App ──────────────────────────────────────────────────────────────
KILN_APP_NAME=cf-knowledge-kiln
KILN_ENV=development            # development | staging | production
KILN_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
KILN_HTTP_PORT=8080             # CF overrides via $PORT

# ─── Database ────────────────────────────────────────────────────────
# Local dev: a direct URL.
# In CF: leave KILN_DATABASE_URL unset and bind a Postgres service;
# the app reads VCAP_SERVICES and finds the credentials there.
KILN_DATABASE_URL=postgresql+asyncpg://kiln:kiln@localhost:5432/kiln  # pragma: allowlist secret
KILN_PG_SERVICE_NAME=cf-knowledge-kiln-db
KILN_PG_POOL_SIZE=5
KILN_PG_POOL_MAX_OVERFLOW=10

# ─── Embedding provider ──────────────────────────────────────────────
# See config/models.example.yaml for the swappable model registry.
# Env vars override config file for secret-bearing fields only.
KILN_EMBEDDING_API_KEY=
KILN_EMBEDDING_BASE_URL=

# ─── Generator provider (optional, /v1/answer endpoint) ──────────────
KILN_GENERATOR_API_KEY=
KILN_GENERATOR_BASE_URL=

# ─── Ingestion ───────────────────────────────────────────────────────
KILN_INGEST_CONCURRENCY=4
KILN_INGEST_MAX_FILE_BYTES=1048576    # 1 MiB; oversize files are skipped with reason

# ─── Retrieval defaults ──────────────────────────────────────────────
KILN_DEFAULT_MAX_CHUNKS=8
KILN_DEFAULT_MAX_TOKENS=3000
KILN_DEFAULT_STATUS_PREFERENCE=active,approved   # comma-separated

# ─── Security ────────────────────────────────────────────────────────
KILN_SOURCE_ALLOWLIST_PATH=config/sources.yaml
KILN_AUTH_MODE=none             # none (dev only) | bearer | mtls
KILN_BEARER_TOKEN=

# ─── Telemetry ───────────────────────────────────────────────────────
KILN_OTEL_EXPORTER_OTLP_ENDPOINT=
KILN_OTEL_SERVICE_NAME=cf-knowledge-kiln
