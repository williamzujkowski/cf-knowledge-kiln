---
# Local cf-knowledge-kiln model registry — homelab-iac kiln-test A.1 (#624).
#
# Created from config/models.example.yaml, switched to intfloat/e5-small-v2
# per #624 acceptance: non-China-origin per ADR-0005, 384-dim, CPU-fast.
# Weights download from HuggingFace on first ingestion attempt (cached to
# ~/.cache/huggingface/).

models:
  embedding:
    provider: local-sentence-transformers
    name: intfloat/e5-small-v2
    dimensions: 384
    batch_size: 32
    device: cpu
    enabled: true
    # e5-small-v2 is a standard BERT architecture — no custom modeling code.
    trust_remote_code: false
    notes: |
      Microsoft intfloat/e5-small-v2. MIT license. Non-China-origin per
      ADR-0005. 384-dim output, ~134MB weights, fast on CPU. Use the
      "query: " / "passage: " prefixes built into the model card if you
      see retrieval-quality drift in Phase A.5.

  generator:
    provider: openai-compatible
    name: phi-4-mini-instruct
    base_url_env: KILN_GENERATOR_BASE_URL
    api_key_env: KILN_GENERATOR_API_KEY  # pragma: allowlist secret
    enabled: false
    default_temperature: 0
    notes: |
      Disabled in A.1 — no /v1/answer synthesis exercised here.

providers:
  openai_compatible:
    timeout_seconds: 60
    max_retries: 2
